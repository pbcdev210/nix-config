{
  "options": {
    "nixos": {
      "expr": "let configs = (builtins.getFlake \"/workspace/nix-config\").nixosConfigurations; in configs.default.options"
    },
    "home-manager": {
      "expr": "let configs = (builtins.getFlake \"/workspaces/nix-config\").homeConfigurations.default.options"
    }
  }
}
